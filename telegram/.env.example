# Copy this file to .env and fill in the values. Never upload .env to GitHub.

# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=123456789:ABC...

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Optional: change the model if this one stops being free
GEMINI_MODEL=gemini-2.5-flash

# Your own Telegram chat id, so booking alerts come to you (see README step 4)
OWNER_CHAT_ID=
